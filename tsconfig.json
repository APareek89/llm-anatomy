{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts", "tests"]
}
